rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /app_settings/{docId} {
      allow read, write: if true;
    }
    match /device_sessions/{sessionId} {
      allow read, write: if true;
    }
    match /device_notifications/{notifId} {
      allow read, write: if true;
    }
  }
}
